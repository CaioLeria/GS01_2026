  <folder name="Motivation" id="id-e372eaa8fe2346bcb0c5201bda6b4740" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="T-Space" id="id-95073cd35c5a42c1aef02923fa799859"/>
    <element xsi:type="archimate:Driver" name="Administrar viagens espaciais" id="id-94250bc7a16b443b9fa758a12f124cb4"/>
    <element xsi:type="archimate:Driver" name="Centralizar a busca e pagamento das viagens" id="id-9c2ea92012c5491b85b3a63040791381"/>
    <element xsi:type="archimate:Driver" name="Facilitar acesso e visibilidade" id="id-f9b451e86ca045ebb3680e107353863b"/>
    <element xsi:type="archimate:Principle" name="Principle" id="id-f1fc8fe929ba4e1c809e9445a6b744c8"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-6731506b43ba43d7b6729874f70b466c"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-ee3dffbc98a446f8a77f2ec86b26fce3"/>
    <element xsi:type="archimate:Goal" name="Entregar um sistema que facila de utilizar, cadastrar e visualizar os dados" id="id-a8fc898d1ae749ad8b184b2f81fb5c2e"/>
    <element xsi:type="archimate:Goal" name="Oferecer dados da empresa, viagens e facilitar o pagamento de forma segura" id="id-d5999abc8fd64f148f3bee9a6b1f73bc"/>
    <element xsi:type="archimate:Goal" name="Entregar dados e viagens de forma segura e confiavel" id="id-e6df4d9342e14e9eb6f6c65807dd2219"/>
    <element xsi:type="archimate:Assessment" name="Adicionar várias formas de pagamento (tercerizar) de forma rápida e eficaz" id="id-3890d29131714b04aefde1872778360f"/>
    <element xsi:type="archimate:Assessment" name="Construir sistema completo" id="id-b898e275acab418096026a4de88e1d3c"/>
    <element xsi:type="archimate:Requirement" name="Cadastrar viagens, exibir dados e relaorios em tempo real" id="id-d151243267d34f53a8122f6b2d505bb1"/>
    <element xsi:type="archimate:Requirement" name="Exibir dados da empresa viagen e facilitar o pagamento do cliente" id="id-cf15e341e95d4e8fb6f572c1dc0ea567"/>
    <element xsi:type="archimate:Requirement" name="Requirement" id="id-361b217281d34fff91c72771d9b4ca07"/>
    <element xsi:type="archimate:Constraint" name="Gerenciamento será feito no nosso sistema, tanto cadastro de viagens como a visibilidade dos dados e acontecimentos" id="id-3995c6a505e146dda4537799226bcccb"/>
    <element xsi:type="archimate:Constraint" name="A exibição e pagamneto da viagem será através de um app/site" id="id-37b96007208d43fba9455b2364f99f82"/>
  </folder>
